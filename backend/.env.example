# Database — Neon PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/group_travel?sslmode=require

# Anthropic — Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Auth — JWT secret (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Push Notifications — VAPID keys (generate with: pywebpush --gen-key)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=your-email@example.com

# Razorpay (apply early — onboarding takes time)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000
