# Database — Neon PostgreSQL. On Vercel this MUST be the pooled endpoint
# (host ends in "-pooler"), not the direct one — each concurrent serverless
# invocation opens its own connection against whatever this points at.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.neon.tech/group_travel?sslmode=require

# Anthropic — Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Auth — JWT secret (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here
NEXTAUTH_SECRET=your-nextauth-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Push Notifications — VAPID keys (generate with: pywebpush --gen-key)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=your-email@example.com

# Razorpay (apply early — onboarding takes time)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Google Places API (optional — backend returns sample POIs when empty)
GOOGLE_MAPS_API_KEY=

# Upstash Redis — SSE pub/sub. Auto-injected if Upstash is added from the
# Vercel dashboard's Storage tab; set by hand for local dev otherwise.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking (optional — Sentry is disabled when empty)
SENTRY_DSN=
